generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  QRIS
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  CANCELLED_SALE
}

enum IngredientUnit {
  GRAM
  MILLILITER
  PIECE
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Jakarta")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  menuStates     BranchMenuState[]
  stocks         BranchStock[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@index([isActive])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sales Sale[] @relation("CashierSales")

  stockMovements StockMovement[] @relation("StockMovementActor")

  @@index([branchId])
  @@index([branchId, role])
  @@index([isActive])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]

  @@index([sortOrder])
}

model MenuItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  price       Int
  imageUrl    String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  branchStates  BranchMenuState[]
  recipes       MenuRecipe[]
  saleItems     SaleItem[]
  catalogEvents CatalogEvent[]

  @@index([categoryId])
  @@index([categoryId, isActive])
}

model BranchMenuState {
  branchId   String
  menuItemId String

  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([branchId, menuItemId])
  @@index([branchId, isAvailable])
}

model Ingredient {
  id        String         @id @default(cuid())
  sku       String         @unique
  name      String
  unit      IngredientUnit
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  recipes        MenuRecipe[]
  branchStocks   BranchStock[]
  stockMovements StockMovement[]

  @@index([isActive])
}

model MenuRecipe {
  menuItemId       String
  ingredientId     String
  quantityRequired Int

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
}

model BranchStock {
  branchId        String
  ingredientId    String
  quantity        Int      @default(0)
  minimumQuantity Int      @default(0)
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([branchId, ingredientId])
  @@index([branchId, quantity])
}

model Sale {
  id             String        @id @default(cuid())
  receiptNumber  String
  idempotencyKey String
  branchId       String
  cashierId      String
  customerName   String?
  businessDate   String
  totalAmount    Int
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus    @default(COMPLETED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  cashier User @relation("CashierSales", fields: [cashierId], references: [id], onDelete: Restrict)

  items          SaleItem[]
  stockMovements StockMovement[]

  @@unique([branchId, receiptNumber])
  @@unique([branchId, idempotencyKey])
  @@index([branchId, businessDate])
  @@index([branchId, businessDate, status])
  @@index([cashierId, createdAt])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  menuItemId String?

  nameSnapshot  String
  priceSnapshot Int
  quantity      Int
  subtotal      Int

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([menuItemId])
}

model StockMovement {
  id            String            @id @default(cuid())
  branchId      String
  ingredientId  String
  saleId        String?
  createdById   String?
  type          StockMovementType
  quantityDelta Int
  balanceAfter  Int
  note          String?
  createdAt     DateTime          @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdBy User? @relation("StockMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, ingredientId, createdAt])
  @@index([saleId])
  @@index([createdById])
}

model CatalogEvent {
  id          Int      @id @default(autoincrement())
  eventType   String
  menuItemId  String
  itemVersion Int
  createdAt   DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, itemVersion])
  @@index([createdAt])
}
